{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/dotfiles/codex-hooks/mcp-startup-check.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/dotfiles/scripts/plan-review/codex-stop-plan-gate.mjs\"",
            "timeout": 900
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex-hooks/stop-notify.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
