{
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Non-empty finding title"
          },
          "body": {
            "type": "string",
            "description": "Non-empty finding body."
          },
          "evidence": {
            "type": "string",
            "description": "Non-empty evidence for the finding."
          },
          "category": {
            "type": "string",
            "enum": ["correctness", "quality"],
            "description": "Finding category: correctness for behavior risks or quality for concrete implementation-quality problems."
          },
          "priority": {
            "type": "integer",
            "enum": [0, 1, 2],
            "description": "Finding priority: 0 for P0, 1 for P1, or 2 for P2."
          },
          "code_location": {
            "type": "object",
            "properties": {
              "absolute_file_path": {
                "type": "string",
                "description": "Non-empty absolute file path."
              },
              "line_range": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "description": "One-based start line; must be at least 1."
                  },
                  "end": {
                    "type": "integer",
                    "description": "One-based end line; must be at least the start line."
                  }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              }
            },
            "required": ["absolute_file_path", "line_range"],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "body",
          "evidence",
          "category",
          "priority",
          "code_location"
        ],
        "additionalProperties": false
      }
    },
    "overall_explanation": {
      "type": "string",
      "description": "Non-empty overall review explanation."
    }
  },
  "required": ["findings", "overall_explanation"],
  "additionalProperties": false
}
