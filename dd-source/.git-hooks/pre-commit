#!/opt/homebrew/bin/bash
set -euo pipefail

# --------------------------- Color Definitions --------------------------- #
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
GREY='\033[0;37m'
RED='\033[0;31m'
NC='\033[0m'

# ---------------------------- Helper Functions ---------------------------- #
log() {
    local color="$1"
    local message="$2"
    echo -e "${color}${message}${NC}"
}

info() { log "${BLUE}" "$1"; }
success() { log "${GREEN}" "$1"; }
warn() { log "${YELLOW}" "$1"; }
error() { log "${RED}" "$1"; }

# This will be set once in the main execution
MERGE_BASE=""

run_bzl_locked() {
    local lock_dir="${HOME}/.cache/datadog/dd-source"
    local lock_file="${lock_dir}/bzl-pre-commit.lock"
    local lock_fd
    local exit_code
    local wait_message="⏳ Another pre-commit hook is using Bazel. Waiting for lock..."

    if ! command -v flock >/dev/null 2>&1; then
        bzl "$@"
        return $?
    fi

    mkdir -p "$lock_dir"
    exec {lock_fd}> "$lock_file"

    if ! flock -n "$lock_fd"; then
        if [[ -e /dev/tty && -w /dev/tty ]]; then
            printf '%b%s%b\n' "${YELLOW}" "$wait_message" "${NC}" > /dev/tty
        else
            warn "$wait_message"
        fi
        flock "$lock_fd"
    fi

    set +e
    bzl "$@"
    exit_code=$?
    set -e

    flock -u "$lock_fd"
    exec {lock_fd}>&-

    return "$exit_code"
}

stage_generated_files() {
    local current_files=$(git diff --name-only)
    local original_files=$BEFORE_HOOK
    local original_staged=$BEFORE_HOOK_STAGED

    if [[ "$original_files" != "$current_files" ]]; then
        warn "📝 Changes detected. Adding modified files to commit..."
        while IFS= read -r file; do
            if [[ "$original_staged" == *"$file"* || "$original_files" != *"$file"* ]]; then
                info "  📝 Adding: $file"
                git add "$file"
            fi
        done <<< "$current_files"
    fi
}

# Returns files eligible for processing - SINGLE SOURCE OF TRUTH for merge detection
# During merge: only files changed in our branch (not incoming merge files)
# Normal commit: all staged files
get_my_branch_files() {
    if [[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]]; then
        git diff --name-only "$MERGE_BASE"..HEAD
    else
        git diff --name-only --staged
    fi
}

diff_for_file() {
    local file="$1"
    if [[ -n "$MERGE_BASE" ]]; then
        git diff -U0 "$MERGE_BASE"..HEAD -- "$file"
    else
        git diff --cached -U0 -- "$file"
    fi
}

# Find the Bazel package containing a file (walks up to find BUILD.bazel)
find_bazel_package() {
    local file="$1"
    local dir=$(dirname "$file")
    while [[ "$dir" != "." && "$dir" != "/" ]]; do
        if [[ -f "$dir/BUILD.bazel" || -f "$dir/BUILD" ]]; then
            echo "$dir"
            return
        fi
        dir=$(dirname "$dir")
    done
}

dir_has_bazel_tests() {
    local dir="$1"
    run_bzl_locked query "tests(//$dir/...)" 2>/dev/null | grep -q .
}

# --------------------------- Change Detectors --------------------------- #
# All detectors use get_my_branch_files as input (centralized filtering)

get_proto_dirs() {
    get_my_branch_files | {
        local dirs=""
        while IFS= read -r file; do
            [[ "$file" == *.proto ]] && dirs+=" $(dirname "$file")"
        done
        echo "$dirs" | xargs -n1 2>/dev/null | sort -u | xargs
    }
}

get_go_generate_files() {
    get_my_branch_files | {
        local files=""
        while IFS= read -r file; do
            [[ "$file" == *.go ]] && [[ -f "$file" ]] && grep -q "//go:generate" "$file" 2>/dev/null && files+=" $file"
        done
        echo "$files" | xargs
    }
}

get_go_import_dirs() {
    get_my_branch_files | {
        local dirs=""
        while IFS= read -r file; do
            [[ "$file" == *.go ]] || continue
            [[ -f "$file" ]] || continue

            if diff_for_file "$file" | grep -Eq '^[+-][[:space:]]*import[[:space:]]*(\\(|")|^[+-][[:space:]]*"[^"]+"'; then
                dirs+=" $(dirname "$file")"
            fi
        done
        echo "$dirs" | xargs -n1 2>/dev/null | sort -u | xargs
    }
}

get_bazel_dirs() {
    get_my_branch_files | {
        local dirs=""
        while IFS= read -r file; do
            [[ "$file" == *.bazel ]] && dirs+=" $(dirname "$file")"
        done
        echo "$dirs" | xargs -n1 2>/dev/null | sort -u | xargs
    }
}

get_go_embed_dirs() {
    get_my_branch_files | {
        local packages=""
        while IFS= read -r file; do
            [[ -f "$file" ]] || continue
            local dir=$(dirname "$file")
            if find "$dir" -maxdepth 1 -name '*.go' -exec grep -l "//go:embed" {} \; 2>/dev/null | head -1 | grep -q .; then
                packages+=" $dir"
            fi
        done
        echo "$packages" | xargs -n1 2>/dev/null | sort -u | xargs
    }
}

get_python_files() {
    get_my_branch_files | {
        local files=""
        while IFS= read -r file; do
            if [[ "$file" == *.py || "$file" == *.pyi ]]; then
                # Skip deleted files
                [[ -f "$file" ]] || continue
                # Exclude protobuf-generated files
                if [[ "$file" != *_pb2.py && "$file" != *_pb2.pyi && "$file" != *_pb2_grpc.py && "$file" != *_pb2_grpc.pyi ]]; then
                    files+=" $file"
                fi
            fi
        done
        echo "$files" | xargs
    }
}

get_assistant_python_files() {
    get_my_branch_files | {
        local files=""
        while IFS= read -r file; do
            if [[ "$file" == domains/assistant/*.py || "$file" == domains/assistant/*.pyi ]]; then
                # Skip deleted files
                [[ -f "$file" ]] || continue
                # Exclude protobuf-generated files
                if [[ "$file" != *_pb2.py && "$file" != *_pb2.pyi && "$file" != *_pb2_grpc.py && "$file" != *_pb2_grpc.pyi ]]; then
                    files+=" $file"
                fi
            fi
        done
        echo "$files" | xargs
    }
}

get_assistant_changed_files() {
    get_my_branch_files | {
        local files=""
        while IFS= read -r file; do
            [[ "$file" == domains/assistant/* ]] && files+=" $file"
        done
        echo "$files" | xargs
    }
}

get_assistant_python_packages() {
    get_my_branch_files | {
        local pkgs=""
        while IFS= read -r file; do
            if [[ "$file" == domains/assistant/*.py || "$file" == domains/assistant/*.pyi ]]; then
                [[ -f "$file" ]] || continue
                if [[ "$file" != *_pb2.py && "$file" != *_pb2.pyi && "$file" != *_pb2_grpc.py && "$file" != *_pb2_grpc.pyi ]]; then
                    local pkg=$(find_bazel_package "$file")
                    [[ -n "$pkg" ]] && pkgs+=" $pkg"
                fi
            fi
        done
        echo "$pkgs" | xargs -n1 2>/dev/null | sort -u | xargs
    }
}

get_python_import_dirs() {
    get_my_branch_files | {
        local dirs=""
        while IFS= read -r file; do
            if [[ "$file" == *.py || "$file" == *.pyi ]]; then
                if [[ "$file" != *_pb2.py && "$file" != *_pb2.pyi && "$file" != *_pb2_grpc.py && "$file" != *_pb2_grpc.pyi ]]; then
                    [[ -f "$file" ]] || continue
                    if diff_for_file "$file" | grep -Eq '^[+-][[:space:]]*(import|from)[[:space:]]'; then
                        dirs+=" $(dirname "$file")"
                    fi
                fi
            fi
        done
        echo "$dirs" | xargs -n1 2>/dev/null | sort -u | xargs
    }
}

get_go_files() {
    get_my_branch_files | {
        local files=""
        while IFS= read -r file; do
            [[ "$file" == *.go ]] && [[ -f "$file" ]] && files+=" $file"
        done
        echo "$files" | xargs
    }
}

# --------------------------- Main Execution --------------------------- #
# Dynamically determine repo root (works in any clone location)
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

BEFORE_HOOK=$(git diff --name-only)
BEFORE_HOOK_STAGED=$(git diff --name-only --staged)

# Cache merge-base once (used by get_my_branch_files/diff_for_file)
GIT_DIR="$(git rev-parse --git-dir)"
if [[ -f "$GIT_DIR/MERGE_HEAD" ]]; then
    MERGE_BASE=$(git merge-base HEAD MERGE_HEAD || true)
    if [[ -z "$MERGE_BASE" ]]; then
        error "❌ Could not determine merge-base; aborting pre-commit."
        exit 1
    fi
fi

# Show merge status if applicable
if [[ -f "$GIT_DIR/MERGE_HEAD" ]]; then
    warn "🔀 Merge detected - only processing files from your branch"
fi

# --------------------------- Protobuf Generation --------------------------- #
warn "🔍 Checking for modified .proto files..."
proto_dirs=$(get_proto_dirs)
if [[ -z "$proto_dirs" ]]; then
    info "  🕵 No .proto file edited. Skipping protobuf generation."
else
    warn "  🕵 Modified .proto files detected. Generating protobuf..."
    # Batch all proto directories into a single bzl run command
    targets=""
    for dir in $proto_dirs; do
        targets+=" //$dir/..."
    done
    info "  🚀 Running: bzl run //:snapshot --$targets"
    run_bzl_locked run //:snapshot --$targets
fi

# --------------------------- Go Generate Handling --------------------------- #
warn "🔍 Checking for '//go:generate' directives..."
generate_files=$(get_go_generate_files)
if [[ -z "$generate_files" ]]; then
    info "  🕵 No '//go:generate' directives found."
else
    warn "  🚀 Found '//go:generate' directives. Running generation..."
    for file in $generate_files; do
        info "  🚀 Generating: $file"
        go generate "$file"
    done
fi

stage_generated_files

# --------------------------- Dependency Management --------------------------- #
warn "🔍 Analyzing code dependencies..."
import_dirs=$(get_go_import_dirs)
python_import_dirs=$(get_python_import_dirs)
bazel_dirs=$(get_bazel_dirs)
embed_dirs=$(get_go_embed_dirs)

all_dirs=$(echo "$import_dirs $python_import_dirs $bazel_dirs $embed_dirs" | xargs -n1 2>/dev/null | sort -u | xargs)

if [[ -n "$all_dirs" ]]; then
    warn "  🚀 Updating build files..."
    info "  🚀 Running: bzl run //:gazelle -- $all_dirs"
    if run_bzl_locked run //:gazelle -- $all_dirs; then
        success "  ✅ Build files updated"
        git add -u $all_dirs/*.bazel 2>/dev/null || true
    else
        warn "  ⚠️ Gazelle encountered issues"
    fi
else
    info "  🕵 No dependency changes detected"
fi

# --------------------------- Formatting --------------------------- #
warn "🔍 Formatting Go files..."
go_files=$(get_go_files)
if [[ -n "$go_files" ]]; then
    info "  🛠 Formatting $(echo "$go_files" | wc -w | tr -d ' ') Go files..."
    # Use native gofmt for much better performance than bazel run
    if gofmt -w $go_files; then
        success "  ✅ Go files formatted successfully"
    else
        error "  ❌ Go formatting failed!"
        exit 1
    fi
else
    info "  🕵 No Go files to format"
fi

stage_generated_files

# --------------------------- Python Formatting --------------------------- #
warn "🔍 Checking Python formatting..."
python_files=$(get_python_files)
if [[ -n "$python_files" ]]; then
    info "  🔎 Checking $(echo "$python_files" | wc -w | tr -d ' ') Python files..."

    # Convert space-separated list to newline-separated for --git-diff-file
    python_files_newline=$(echo "$python_files" | tr ' ' '\n')
    python_files_changed_before=$(git diff --name-only -- $python_files | sort)

    # Run ruff formatter - use filtered python_files to exclude deleted files
    info "  🚀 Running: bzl run //tools/format:format_ruff -- --git-diff-file <python file list>"
    if run_bzl_locked run //tools/format:format_ruff -- --git-diff-file <(echo "$python_files_newline"); then
        python_files_changed_after=$(git diff --name-only -- $python_files | sort)
        newly_formatted_files=$(
            comm -13 \
                <(printf '%s\n' "$python_files_changed_before") \
                <(printf '%s\n' "$python_files_changed_after") \
            | sed '/^$/d'
        )
        if [[ -n "$newly_formatted_files" ]]; then
            success "  ✅ Applied formatting to $(echo "$newly_formatted_files" | wc -l | tr -d ' ') Python files"
        else
            success "  ✅ No Python formatting changes needed"
        fi
    else
        error "  ❌ Python formatting failed!"
        exit 1
    fi

    # Run ruff linter
    info "  🚀 Running: bzl run //tools/format:lint_ruff -- --git-diff-file <python file list>"
    if run_bzl_locked run //tools/format:lint_ruff -- --git-diff-file <(echo "$python_files_newline"); then
        success "  ✅ Python linting passed"
    else
        error "  ❌ Python linting failed!"
        exit 1
    fi
else
    info "  🕵 No Python files to format"
fi

stage_generated_files

# --------------------------- Python Type Checking (domains/assistant) --------------------------- #
warn "🔍 Checking Python types in domains/assistant..."
assistant_python_files=$(get_assistant_python_files)
if [[ -n "$assistant_python_files" ]]; then
    info "  🔎 Running mypy on changed packages in domains/assistant..."

    # Get unique package directories from changed files
    assistant_packages=$(get_assistant_python_packages)

    # Build Bazel targets from directories
    targets=""
    for pkg in $assistant_packages; do
        targets+=" //$pkg/..."
    done

    info "  🎯 Targets:$targets"

    if run_bzl_locked build --build_tag_filters=dd-mypy,-latest --config=mypy $targets 2>&1 | tee /tmp/mypy_output.txt; then
        success "  ✅ Python type checking passed"
    else
        error "  ❌ Python type checking failed!"
        error "  Run: bzl build --build_tag_filters=dd-mypy,-latest --config=mypy $targets"
        grep -E "(error|Error)" /tmp/mypy_output.txt | tail -20
        exit 1
    fi
else
    info "  🕵 No Python files in domains/assistant to type-check"
fi

