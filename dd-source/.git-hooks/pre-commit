# --------------------------- Assistant Tests (domains/assistant) --------------------------- #
warn "🔍 Running tests in domains/assistant..."
assistant_changed_files=$(get_assistant_changed_files)
if [[ -n "$assistant_changed_files" ]]; then
    assistant_test_targets="//domains/assistant/...:all"

    info "  🧪 Running: bzl test --build_tests_only $assistant_test_targets"
    if run_bzl_locked test --build_tests_only $assistant_test_targets; then
        success "  ✅ domains/assistant tests passed"
    else
        error "  ❌ domains/assistant tests failed!"
        error "  Run: bzl test --build_tests_only $assistant_test_targets"
        exit 1
    fi
else
    info "  🕵 No branch-local files in domains/assistant to test"
fi


success "✅ All pre-commit checks completed successfully! 🎉"
