{
  "defaultProvider": "ai-gw-anthropic-1m",
  "defaultModel": "anthropic/claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "extensions": [
    "~/dotfiles/pi-extensions/slack-notify.mjs",
    "~/dotfiles/pi-extensions/mcp-startup-check.mjs"
  ],
  "packages": [
    "npm:pi-subagents",
    "npm:pi-powerline-footer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@datadog/pi-plugin",
    "../../dd/datadog-pi-packages/packages/refresh-models",
    "../../dd/datadog-pi-packages/packages/research-web",
    "../../dd/datadog-pi-packages/packages/session-cost",
    "../../dd/datadog-pi-packages/packages/compaction-continue",
    "../../dd/datadog-pi-packages/packages/dd-pi-packages-sync",
    "../../dd/datadog-pi-packages/packages/pi-npm-guard",
    "../../dd/datadog-pi-packages/packages/npm-update-cooldown",
    "../../dd/datadog-pi-packages/packages/mcp-port-forward",
    "npm:@getpipher/vision"
  ],
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "powerline": {
    "separator": "pipe"
  },
  "npmCommand": [
    "sh",
    "-c",
    "exec \"$HOME/dd/datadog-pi-packages/packages/pi-npm-guard/bin/pi-npm-guard.mjs\" \"$@\"",
    "pi-npm-guard"
  ],
  "npmGuard": {
    "enabled": true,
    "middlewares": [
      {
        "path": "../../npm-update-cooldown/middleware/cooldown.mjs",
        "config": {
          "days": 2
        }
      }
    ]
  }
}
